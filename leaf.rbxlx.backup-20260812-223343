						<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

-- A REAL physical board in the Lobby (Workspace.StartingLobby.HallOfFameBoard, placed via direct
-- rbxlx surgery -- see CLAUDE.md's "Building a new map" process for why Workspace geometry can't be
-- added any other way) showing the all-time top 10 by lifetime leaves cleaned
-- (HallOfFameSystem.luau, server, backed by an OrderedDataStore). A SurfaceGui, not a BillboardGui
-- and not a screen-space ScreenGui panel -- SurfaceGui reads as a genuine sign/plaque mounted on the
-- world object, the same choice this project already made for every Cleanup Zone sign (see
-- CLAUDE.md's "Sign/text-label direction" note: "never a BillboardGui" -- a BillboardGui always
-- faces the camera and fades by distance, which reads as a floating tooltip, not a real board).
-- Needs no explicit visibility gating at all -- it's simply not visible once a round teleports a
-- player RoundConfig.MapAwayOffset (10,000 studs) away from the Lobby, the same way every other
-- physical Lobby prop (the NPC rigs, the shop booth) already works with zero code for it.
local HallOfFameUI = {}

local TITLE_COLOR = Color3.fromRGB(255, 236, 200)
local RANK_COLOR = Color3.fromRGB(214, 180, 140)
local NAME_COLOR = Color3.fromRGB(240, 228, 210)
local COUNT_COLOR = Color3.fromRGB(214, 180, 140)
local YOU_NAME_COLOR = Color3.fromRGB(120, 190, 255)
local PLACEHOLDER_COLOR = Color3.fromRGB(180, 160, 140)
local BACKGROUND_COLOR = Color3.fromRGB(40, 25, 15)
local ACCENT_COLOR = Color3.fromRGB(224, 168, 96)

-- Same medal glyphs RoundResultsUI.luau's own top-3 rows use, so a top-3 Hall of Fame entry reads
-- consistently with a top-3 round finish rather than inventing a new look.
local RANK_MEDALS = { [1] = "\u{1F947}", [2] = "\u{1F948}", [3] = "\u{1F949}" }

local MAX_ROWS = 10
local TITLE_HEIGHT_SCALE = 0.16
local ROW_GAP = 0.02

local function buildBoardUI(board)
	local existing = board:FindFirstChild("HallOfFameSurface")
	if existing then
		existing:Destroy()
	end

	local surfaceGui = Instance.new("SurfaceGui")
	surfaceGui.Name = "HallOfFameSurface"
	-- The board was authored (leaf.rbxlx) sitting north of the Lobby's spawn/shop cluster, no
	-- rotation of its own -- Back (+Z normal) is the face a viewer approaching from smaller Z (i.e.
	-- from spawn) actually sees, per CLAUDE.md's Face convention for a sign north of where players
	-- stand.
	surfaceGui.Face = Enum.NormalId.Back
	surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surfaceGui.PixelsPerStud = 50
	surfaceGui.LightInfluence = 0
